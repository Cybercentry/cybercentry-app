# ─────────────────────────────────────────────────────────────────────────────
# Cybercentry Base Token Verification — Mini App environment
# Copy to .env.local for local dev; set the same keys in Railway for production.
# ─────────────────────────────────────────────────────────────────────────────

# CBTV proxy — SERVER-ONLY. These never reach the browser (no NEXT_PUBLIC_ prefix),
# so the API key stays secret. The Next.js /api/verify route adds the key and calls
# the proxy on the browser's behalf.
CBTV_API_URL=https://your-cbtv-proxy.up.railway.app
CBTV_API_KEY=replace-with-your-cbtv-api-key

# Dedicated ERC-4337 bundler for verifying Base Pay payments. STRONGLY recommended
# on mainnet — the SDK's default public bundler rate-limits and returns
# "Invalid response" / "not_found", which rejects real payments. Use a CDP Base
# RPC (Coinbase Developer Platform / base.dev):
#   https://api.developer.coinbase.com/rpc/v1/base/<YOUR_CDP_CLIENT_KEY>
PAY_BUNDLER_URL=

# Full JSON-RPC endpoint for reading tx receipts (verifies native sendCalls
# payments). A CDP Base RPC serves both eth_ and bundler methods, so this can be
# left blank to reuse PAY_BUNDLER_URL; set it only if that endpoint is
# bundler-only. Required for the no-flash native-wallet payment path on mainnet.
PAY_RPC_URL=

# Base Pay — where the $1 USDC lands, and which network.
# NEXT_PUBLIC_ = readable in the browser (needed by pay() on the client).
# Base Pay settles USDC on Base (EVM); the Solana treasury is not used here.
NEXT_PUBLIC_TREASURY_ADDRESS=0xfEE13309251B632317ea2d475d6ABa7E7E0219e6
# "true" = Base Sepolia testnet (use while testing with faucet USDC).
# "false" = Base mainnet (real USDC) for launch.
NEXT_PUBLIC_PAY_TESTNET=true

# Optional: builder-code attribution suffix appended to the Base Pay transaction
# (ERC-8021). Leave blank to skip. Example from your builder code bc_f99p1h3s:
# 0x62635f66393970316833730b0080218021802180218021802180218021
NEXT_PUBLIC_BUILDER_DATA_SUFFIX=

# ── Optional ────────────────────────────────────────────────────────────────
# base.dev App API key — auth for the Base Dashboard notifications API
# (x-api-key on dashboard.base.org/api/v1/notifications/send, see lib/notify.ts).
# Base Pay / getPaymentStatus need NO key. Leave blank to disable notifications.
APP_API_KEY=

# NEXT_PUBLIC_ONCHAINKIT_API_KEY — leftover from the old waitlist app. We use
# Base Pay (@base-org/account), not OnchainKit, so this is UNUSED. Safe to remove
# from Railway. Left here only to document that it is intentionally not used.
# NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# ── Per-wallet burst cap ────────────────────────────────────────────────────
# A short-window cap on requests per wallet (lib/replay-store.ts, countRequest).
# This is a burst cap, NOT a spend cap: payment already limits total volume, so
# a daily ceiling would mostly inconvenience paying customers. What CBTV needs
# protecting from is a fast burst - it bounds its own concurrency (2 sync /
# 4 background / 4 quote-asset) and refuses beyond it with 503, so without a cap
# here one script can fill those pools and every other caller collects 503s.
#
# Keep the limit BELOW upstream capacity so this is the binding constraint.
# Otherwise callers hit CBTV's 503 before this 429 and the error stops being
# attributable: a partner cannot tell "I went too fast" from "the service is
# busy", and neither can we from the logs.
#
# Counted before any payment or free scan is consumed, so a 429 never burns an
# entitlement - the same paymentId can be retried once the window rolls over.
# Fails OPEN if Postgres is unavailable, falling back to per-instance counting.
# VERIFY_BURST_LIMIT=10
# VERIFY_BURST_WINDOW_S=60
