# ─────────────────────────────────────────────────────────────────────────────
# Cybercentry Base Token Verification — Mini App environment
# Copy to .env.local for local dev; set the same keys in Railway for production.
# ─────────────────────────────────────────────────────────────────────────────

# CBTV proxy — SERVER-ONLY. These never reach the browser (no NEXT_PUBLIC_ prefix),
# so the API key stays secret. The Next.js /api/verify route adds the key and calls
# the proxy on the browser's behalf.
CBTV_API_URL=https://your-cbtv-proxy.up.railway.app
CBTV_API_KEY=replace-with-your-cbtv-api-key

# Base Pay — where the $1 USDC lands, and which network.
# NEXT_PUBLIC_ = readable in the browser (needed by pay() on the client).
# Base Pay settles USDC on Base (EVM); the Solana treasury is not used here.
NEXT_PUBLIC_TREASURY_ADDRESS=0xfEE13309251B632317ea2d475d6ABa7E7E0219e6
# "true" = Base Sepolia testnet (use while testing with faucet USDC).
# "false" = Base mainnet (real USDC) for launch.
NEXT_PUBLIC_PAY_TESTNET=true

# Optional: builder-code attribution suffix appended to the Base Pay transaction
# (ERC-8021). Leave blank to skip. Example from your builder code bc_f99p1h3s:
# 0x62635f66393970316833730b0080218021802180218021802180218021
NEXT_PUBLIC_BUILDER_DATA_SUFFIX=

# ── Optional / not required for v1 ──────────────────────────────────────────
# base.dev Mini App API key — for Base notifications and other Base services
# later. Base Pay / getPaymentStatus need NO key, so this is unused for now.
MINI_APP_API_KEY=

# NEXT_PUBLIC_ONCHAINKIT_API_KEY — leftover from the old waitlist app. We use
# Base Pay (@base-org/account), not OnchainKit, so this is UNUSED. Safe to remove
# from Railway. Left here only to document that it is intentionally not used.
# NEXT_PUBLIC_ONCHAINKIT_API_KEY=
